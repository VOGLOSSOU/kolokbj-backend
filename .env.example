# Copier en .env et adapter.

PORT=3000
NODE_ENV=development

# PostgreSQL (sur Railway : la variable DATABASE_URL du service Postgres)
DATABASE_URL=postgresql://kolok:kolok@localhost:5432/kolok

# Signature des JWT de session. Générer avec : openssl rand -hex 32
JWT_SECRET=
JWT_EXPIRES_IN=30d

# Sert à hacher les identifiants bannis (et le NPI en V2). Générer une fois, NE JAMAIS changer :
# les empreintes déjà stockées deviendraient inutilisables.
HASH_SECRET=

# Client ID Google Identity Services (le même que VITE_GOOGLE_CLIENT_ID côté front)
GOOGLE_CLIENT_ID=

# Origines autorisées à appeler l'API, séparées par des virgules
CORS_ORIGINS=http://localhost:5173

# Adresses Google des admins, séparées par des virgules
ADMIN_EMAILS=

# Adresse du front, utilisée dans les liens des notifications
APP_URL=http://localhost:5173

# Web Push (optionnel en dev). Générer avec : npx web-push generate-vapid-keys
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:contact@example.com

# true = ne lance pas les tâches planifiées (relance J+7)
DISABLE_JOBS=false
